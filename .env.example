# Copy this file to .env and fill in both passwords. .env is ignored by git, so it stays on your machine.
# Make each one long and random, for example:  openssl rand -hex 24

# Password for Redis. Docker requires it to start Redis, and the Python programs use it to connect.
REDIS_PASSWORD=

# Password for the dashboard login. If you leave it empty the dashboard has no login.
DASHBOARD_PASSWORD=
