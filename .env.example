# OPTIONAL. You do not need a .env file at all. With no passwords everything still runs, and since
# Kafka, Redis and the dashboard only listen on localhost that is fine for a local demo.
#
# To turn passwords on: copy this file to .env, fill in the ones you want, then run
#   docker compose up -d        (so Redis picks up its password)
# and restart the detector and the dashboard. Make each password long and random, for example:
#   openssl rand -hex 24
# .env is ignored by git, so it stays on your machine.

# Password for Redis. Empty means none.
REDIS_PASSWORD=

# Password for the dashboard login box. Empty means no login.
DASHBOARD_PASSWORD=
